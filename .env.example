SMTP_ADMIN_EMAIL=support@konglomerat.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@konglomerat.org
SMTP_PASS=replace-with-a-google-app-password
SMTP_SENDER_NAME=support@konglomerat.org

OPENINARY_BASE_URL=https://media.konglomerat.org
OPENINARY_API_KEY=replace-with-an-openinary-api-key

BAMBULAB_EMAIL=replace-with-the-bambu-account-email
BAMBULAB_PASSWORD=replace-with-the-bambu-account-password
BAMBULAB_ACCESS_TOKEN=replace-with-an-initial-access-token
BAMBULAB_REFRESH_TOKEN=replace-with-an-initial-refresh-token
BAMBULAB_TOKEN_STORE_PATH=.data/bambulab-tokens.json
BAMBULAB_TOKEN_STORE_BUCKET=bambu-auth
BAMBULAB_TOKEN_STORE_OBJECT=tokens.json
BAMBULAB_VERIFICATION_TIMEOUT_MS=120000

TEAMUP_API_KEY=replace-with-a-teamup-api-key
TEAMUP_READ_CALENDAR_KEY=replace-with-a-read-only-teamup-calendar-key
TEAMUP_WRITE_CALENDAR_KEY=replace-with-a-modify-teamup-calendar-key
