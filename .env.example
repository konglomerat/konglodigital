SMTP_ADMIN_EMAIL=support@konglomerat.org
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@konglomerat.org
SMTP_PASS=replace-with-a-google-app-password
SMTP_SENDER_NAME=support@konglomerat.org

OPENINARY_BASE_URL=https://media.konglomerat.org
OPENINARY_API_KEY=replace-with-an-openinary-api-key

# Payload CMS. Published Pages provide editorial content for the home page,
# Verein, Werkbereiche, Monatsbeitrag, individual Werkbereich pages, and
# arbitrary public subpages (for example a Page with slug kontakt -> /kontakt).
# The header/footer globals also use this origin for public navigation.
PAYLOAD_CMS_URL=https://backend.konglomerat.org

BAMBULAB_EMAIL=replace-with-the-bambu-account-email
BAMBULAB_PASSWORD=replace-with-the-bambu-account-password
BAMBULAB_ACCESS_TOKEN=replace-with-an-initial-access-token
BAMBULAB_REFRESH_TOKEN=replace-with-an-initial-refresh-token
BAMBULAB_TOKEN_STORE_PATH=.data/bambulab-tokens.json
BAMBULAB_TOKEN_STORE_BUCKET=bambu-auth
BAMBULAB_TOKEN_STORE_OBJECT=tokens.json
BAMBULAB_VERIFICATION_TIMEOUT_MS=120000

# Admin-only print automation. Keep live mode off until camera + signed print
# adapter have been verified on the actual printer firmware. See docs/printer-automation.md.
PRINTER_BRIDGE_URL=http://127.0.0.1:8787
PRINTER_BRIDGE_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
PRINTER_AUTOMATION_WORKER_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PRINTER_AUTOMATION_APP_URL=http://localhost:3000
PRINTER_AUTOMATION_LIVE_ENABLED=false
# Private persistent server volume for history drafts, uploaded draft files and last camera photos.
PRINTER_AUTOMATION_DATA_DIR=.data/printer-automation
PRINTER_BED_VISION_MODEL=gpt-4.1

TEAMUP_API_KEY=replace-with-a-teamup-api-key
TEAMUP_READ_CALENDAR_KEY=replace-with-a-read-only-teamup-calendar-key
TEAMUP_WRITE_CALENDAR_KEY=replace-with-a-modify-teamup-calendar-key

# Server camera container: forward a short-lived Bambu access session per capture
PRINTER_BRIDGE_FORWARD_CLOUD_LOGIN=false
