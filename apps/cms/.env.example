# Added by Payload
PREVIEW_SECRET=YOUR_SECRET_HERE
# Used to validate preview requests
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Secret used to authenticate cron jobs
NEXT_PUBLIC_SERVER_URL=https://backend.konglomerat.org
# Used to configure CORS, format links and more. No trailing slash
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Used to encrypt JWT tokens
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name
# Or use a PG connection string
POSTGRES_URL=postgres://user:password@localhost:5432/konglo
# Database connection string

# Shared website / CMS login. Configure all values before enabling and restart Payload.
SUPABASE_SSO_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# NEXT_PUBLIC_SERVER_URL above must be the public CMS origin.
# Register <CMS origin>/api/sso/callback with client_secret_basic in Supabase.

# Persistent upload volume in the production container
PAYLOAD_MEDIA_DIR=/app/public/media
PAYLOAD_MEDIA_PUBLIC_ORIGIN=https://backend.konglomerat.org
# Local shared editing only; leave these unset in the production container.
# PAYLOAD_MEDIA_SSH_HOST=konglo-server
# PAYLOAD_MEDIA_REMOTE_DIR=/var/lib/docker/volumes/konglo-payload-media/_data
# CMS_SSH_HOST=konglo-server
# CMS_DB_SERVICE=konglo-cms-postgres-bpnl8u

# Shared media library; API key is server-only, never NEXT_PUBLIC_.
OPENINARY_BASE_URL=https://media.konglomerat.org
OPENINARY_API_KEY=replace-with-an-openinary-api-key
OPENINARY_FOLDER=konglo-cms
# Keep PAYLOAD_MEDIA_DIR for existing media and document formats (e.g. PDF).
