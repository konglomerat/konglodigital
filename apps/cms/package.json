{
  "name": "konglo-cms",
  "version": "1.0.0",
  "description": "Payload CMS for Konglo Digital",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:sso": "node --test scripts/test-supabase-sso.mjs",
    "build": "next build --webpack",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "node scripts/dev-shared-cms.mjs",
    "dev:prod": "npm run build && npm run start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "dev:local": "node scripts/dev-shared-cms.mjs",
    "test": "node --experimental-strip-types --test scripts/test-supabase-sso.mjs scripts/test-inline-pages.mjs scripts/test-shared-files.mjs"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "3.90.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/payload-cloud": "3.90.2",
    "@payloadcms/plugin-cloud-storage": "3.90.2",
    "@payloadcms/plugin-form-builder": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-search": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "geist": "^1.3.0",
    "graphql": "^16.8.2",
    "lucide-react": "^0.378.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "payload": "3.90.2",
    "prism-react-renderer": "^2.3.1",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "react-hook-form": "7.45.4",
    "sharp": "0.32.6",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.5.4",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "^10.4.19",
    "copyfiles": "^2.4.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "overrides": {
    "fast-xml-parser": "4.5.5"
  },
  "private": true
}
